##############################################################################
################################# makefile-s #################################
##############################################################################
#                                                                            #
#   makefile of MultiKnapsackAssignBlock and its dependencies, excluding     #
#   SMS++                                                                    #
#                                                                            #
#   The makefile defines internally all external libraries required by       #
#   MultiKnapsackAssignBlock (i.e., BinaryKnapsackBlock), excluding the      #
#   SMS++ core ones whose symbols are assumed to have been defined already   #
#   (typically by including SMS++/lib/makefile). Accordingly, all            #
#   necessary OBJ, H, -I directives, external libraries + -L< libdirs > are  #
#   added to the corresponding MKABk* macros.                                #
#                                                                            #
#   Input:  $(CC)        = compiler command                                  #
#           $(SW)        = compiler options                                  #
#           $(SMS++INC)  = the -I$( core SMS++ directory )                   #
#           $(SMS++OBJ)  = the core SMS++ library                            #
#           $(MKABkSDR)  = the directory where the source is                 #
#           $(MKABkODR)  = the directory where the objects have to be put    #
#                                                                            #
#   Output: $(MKABkOBJ)  = the final object(s) / library                     #
#           $(MKABkLIB)  = external libraries + -L< libdirs >                #
#           $(MKABkH)    = the .h files to include                           #
#           $(MKABkINC)  = the -I$( source directory )                       #
#                                                                            #
#                             Antonio Frangioni                              #
#                         Dipartimento di Informatica                        #
#                             Universita' di Pisa                            #
#                                                                            #
##############################################################################

# define & include the necessary modules- - - - - - - - - - - - - - - - - - -
# if a module is not used in the current configuration, just comment out the
# corresponding include line
# each module outputs some macros to be used here:
# *OBJ is the final object/library
# *H   is the list of all include files
# *INC is the -I< include directories >

# define input macros for BinaryKnapsackBlock makefile, then include it
BKBkSDR = $(MKABkSDR)/../BinaryKnapsackBlock
include $(BKBkSDR)/makefile-s

# include the makefile requiring all external modules in input
include $(MKABkSDR)/makefile

# macros to be exported - - - - - - - - - - - - - - - - - - - - - - - - - - -

# append external -I directives to MKABkINC, MKABkOBJ and MKABkH as defined
# by the makefile, thus the := assignment has to be used (use GNU make)
MKABkOBJ := $(MKABkOBJ) $(BKBkOBJ)
MKABkINC := $(MKABkINC) $(BKBkINC)

# external libraries for MultiKnapsackAssignBlock
MKABkLIB = $(BKBkLIB)

############################ End of makefile #################################
